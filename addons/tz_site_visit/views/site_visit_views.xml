<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tz_site_visit_tree" model="ir.ui.view">
        <field name="name">tz.site.visit.tree</field>
        <field name="model">tz.site.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="visit_datetime"/>
                <field name="lead_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>
                <field name="property_unit_id"/>
                <field name="area"/>
                <field name="sale_price"/>
                <field name="status"/>
                <field name="meeting_event_id"/>
            </tree>
        </field>
    </record>

    <record id="view_tz_site_visit_form" model="ir.ui.view">
        <field name="name">tz.site.visit.form</field>
        <field name="model">tz.site.visit</field>
        <field name="arch" type="xml">
            <form string="Site Visit">
                <header>
                    <button name="action_create_calendar_meeting"
                            string="Create Calendar Meeting"
                            type="object"
                            class="btn-primary"
                            invisible="meeting_event_id"/>

                    <button name="action_open_calendar_meeting"
                            string="Open Calendar Meeting"
                            type="object"
                            class="btn-secondary"
                            invisible="not meeting_event_id"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="scheduled,confirmed,completed,interested,negotiation,closed,lost,cancelled"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="lead_id"/>
                            <field name="customer_id"/>
                            <field name="agent_id"/>
                            <field name="visit_datetime"/>
                            <field name="meeting_event_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="property_unit_id"/>
                            <field name="property_type" readonly="1"/>
                            <field name="area" readonly="1"/>
                            <field name="sale_price" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Feedback">
                            <field name="feedback"/>
                        </page>

                        <page string="Next Action">
                            <field name="next_action"/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_tz_site_visit_calendar" model="ir.ui.view">
        <field name="name">tz.site.visit.calendar</field>
        <field name="model">tz.site.visit</field>
        <field name="arch" type="xml">
            <calendar string="Site Visits"
                      date_start="visit_datetime"
                      color="agent_id">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>
                <field name="property_unit_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="view_tz_site_visit_search" model="ir.ui.view">
        <field name="name">tz.site.visit.search</field>
        <field name="model">tz.site.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>
                <field name="property_unit_id"/>
                <field name="area"/>

                <filter string="Scheduled" name="scheduled" domain="[('status','=','scheduled')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('status','=','confirmed')]"/>
                <filter string="Completed" name="completed" domain="[('status','=','completed')]"/>
                <filter string="Interested" name="interested" domain="[('status','=','interested')]"/>
                <filter string="Negotiation" name="negotiation" domain="[('status','=','negotiation')]"/>
                <filter string="Lost" name="lost" domain="[('status','=','lost')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status','=','cancelled')]"/>

                <group expand="0" string="Group By">
                    <filter string="Agent" name="group_agent" context="{'group_by':'agent_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Area" name="group_area" context="{'group_by':'area'}"/>
                    <filter string="Visit Date" name="group_visit_date" context="{'group_by':'visit_datetime'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tz_site_visit" model="ir.actions.act_window">
        <field name="name">Site Visits</field>
        <field name="res_model">tz.site.visit</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="search_view_id" ref="view_tz_site_visit_search"/>
    </record>

    <menuitem id="menu_tz_site_visit_root"
              name="Site Visits"
              parent="crm.crm_menu_root"
              action="action_tz_site_visit"
              sequence="75"/>

</odoo>