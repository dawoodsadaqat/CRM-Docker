<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_lead_form_tz_voip" model="ir.ui.view">
        <field name="name">crm.lead.form.tz.voip</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_voip_call_customer"
                        string="VOIP Call"
                        type="object"
                        class="btn-primary"
                        icon="fa-phone"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_call_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-phone"
                        invisible="call_log_count == 0">
                    <field name="call_log_count"
                           widget="statinfo"
                           string="Calls"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>